# ============================================================
# Environment Variables Template for Industrial Emission Detector
# Copy this file to .env and fill in your actual credentials.
# ============================================================

# Groq API Key (Primary LLM Engine for extraction & chat copilot)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional Secondary Credentials
GEMINI_API_KEY=
HF_TOKEN=

# Google OAuth Sign-In (Frontend)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

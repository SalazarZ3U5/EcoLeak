# ============================================================
# EcoLeak Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# ============================================================

# Groq API Key (Primary LLM Engine for extraction & chat copilot)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional Secondary LLM Credentials
GEMINI_API_KEY=
HF_TOKEN=

# Google OAuth Sign-In (Frontend)
VITE_GOOGLE_CLIENT_ID=

# Firebase Configuration (Frontend Web SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (Backend server-side token verification)
# Option A: Path to service account JSON key file
FIREBASE_ADMIN_KEY_PATH=
# Option B: Project ID only (uses Google public keys for verification)
FIREBASE_PROJECT_ID=

# Supabase Configuration (Frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Configuration (Backend — for audit persistence & JWT verification)
SUPABASE_URL=
SUPABASE_KEY=